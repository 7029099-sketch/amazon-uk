{
  "source": "amazon-us",
  "mode": "verified-snapshot",
  "minDiscount": 35,
  "minRating": 4.5,
  "minReviews": 1000,
  "maxPriceUsd": 100,
  "maxWeightKg": 2,
  "preferredMaxWeightKg": 1,
  "preferredPriceUsd": {
    "min": 15,
    "max": 80
  },
  "currency": "USD",
  "targetCurrency": "UAH",
  "defaultUsdUahRate": 42,
  "shipping": {
    "baseUsd": 6.9,
    "extraPerKgUsd": 4.1,
    "billableWeightRule": "max_actual_or_volumetric"
  },
  "serviceFee": {
    "type": "percent_with_minimum",
    "percent": 12,
    "minimumUsd": 8
  },
  "customs": {
    "limitEur": 150,
    "recommendedMaxEur": 145,
    "defaultEurUsdRate": 1.17,
    "message": "Стоимость товаров в одном международном отправлении для одного получателя рекомендуется держать до 150 евро. При превышении лимита могут возникнуть таможенные платежи."
  },
  "selection": {
    "preferredCategories": [
      "home",
      "kitchen",
      "travel",
      "toys",
      "office",
      "pets"
    ],
    "preferCompactItems": true,
    "preferLowVolumetricWeight": true,
    "preferNoSizing": true,
    "preferNoCompatibility": true,
    "preferNoBattery": true,
    "preferNonFragile": true,
    "avoidRestrictedShippingCategories": true,
    "preferStrongRealDiscounts": true,
    "targetMarginMinUsd": 8,
    "deprioritize": [
      "clothing",
      "shoes",
      "liquids",
      "cosmetics",
      "perfume",
      "large-appliances",
      "phones",
      "expensive-electronics",
      "glass",
      "battery-goods",
      "model-specific-auto",
      "supplements"
    ]
  },
  "discovery": {
    "enabled": false,
    "endpoint": "/api/search",
    "timeoutMs": 7000,
    "minimumQueryLength": 2,
    "fallback": "verified-snapshot",
    "activeSources": [
      "amazon-us"
    ],
    "plannedSources": [
      "walmart-us",
      "ebay-us",
      "target-us",
      "bestbuy-us"
    ],
    "credentials": "server-side-only",
    "notes": "Enable only after a backend search endpoint is deployed. The browser must never contain marketplace API secrets."
  },
  "sourceLabels": {
    "amazon-us": "Amazon",
    "walmart-us": "Walmart",
    "ebay-us": "eBay",
    "target-us": "Target",
    "bestbuy-us": "Best Buy"
  },
  "verification": {
    "targetCadenceHours": 8,
    "hideIfVerificationFails": true,
    "neverLabelManualSnapshotAsLive": true,
    "requirePrice": true,
    "requireRating": true,
    "requireReviews": true,
    "requireShippingCheck": true,
    "notes": "Three planned checks per Ukraine local day: morning, lunchtime, evening (Europe/Kyiv). Exact hours TBD. Do not imply every eight hours or overnight checks. Provider-specific freshness and rights restrictions still apply."
  },
  "compliance": {
    "enforceForPublicCatalog": true,
    "maxPriceAgeHours": 24,
    "requireSourceUrl": true,
    "requireSourceAttribution": true,
    "requireContentUseBasis": true,
    "requirePriceTimestamp": true,
    "requireShippingReview": true,
    "requireTrademarkReviewForAds": true,
    "requireIndependentBrandBeforeAds": true,
    "requireClearAdvertiserIdentity": true,
    "requireAffiliateDisclosureWhenApplicable": true,
    "forbidOfficialPartnerClaimsWithoutProof": true,
    "forbidMarketplaceCustomerCredentials": true,
    "forbidMarketplaceFraming": true,
    "forbidMarketplaceMarkInFinalDomain": true,
    "separateAffiliateAndManagedPurchaseFlows": true,
    "amazonAssociates": {
      "programContentOnlyLinksToAmazon": true,
      "specialLinksOnlyToAmazon": true,
      "managedPurchaseOnBehalfMustNotUseAssociatesFlow": true,
      "noCustomerAmazonCredentials": true,
      "noAmazonSiteFraming": true,
      "thirdPartySellerMarksRequireRights": true,
      "offlineProgramContentRestricted": true
    },
    "ads": {
      "landingPageMustStateAdvertiserRole": true,
      "landingPageMustShowCommercialInfo": true,
      "noMisleadingAffiliation": true,
      "businessNameMustMatchVerifiedIdentity": true,
      "adPriceMustMatchLandingPageOrBeClearlyQualified": true
    },
    "launchGates": {
      "independentBrandSelected": true,
      "finalDomainSelected": false,
      "marketplaceDataRightsReviewed": false,
      "amazonAssociatesFlowReviewed": false,
      "managedPurchaseFlowReviewed": false,
      "advertisingPoliciesReviewed": false,
      "privacyAndTermsReviewed": false,
      "taxAndFiscalFlowReviewed": false,
      "carrierRestrictionsReviewed": false
    },
    "notes": "Fail-closed public catalog. A source's permitted rights, price freshness and required disclosure must be validated by server-side enforcement before any offer is published. Configuration alone does not enforce compliance."
  },
  "hideExpiredDeals": true,
  "notes": "Current feed is a manually verified snapshot. Replace it with approved server-side marketplace data before claiming live or automatic prices. Daily automation should compare previous snapshots, preserve history and mark stale/expired products inactive instead of deleting order history."
}
